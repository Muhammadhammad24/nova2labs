# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env (local) and set the same values in your host's dashboard.
# VITE_* values are readable in the browser — never put secrets in those.
# ─────────────────────────────────────────────────────────────────────────────

# Absolute site origin, no trailing slash. Drives canonical URLs, the sitemap,
# Open Graph tags and JSON-LD.
VITE_SITE_URL=https://www.nova2labs.com

# ── EMAIL: contact form → your own mailbox (Hostinger) ──────────────────────
# Server-side only. These never reach the browser.
# Hostinger: hPanel → Emails → your domain → "Connect apps & devices"
#            (SMTP host is usually smtp.hostinger.com, port 465, SSL)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@nova2labs.com
SMTP_PASS=your-mailbox-password-here

# Optional — defaults to SMTP_USER / the site contact address.
# SMTP_FROM=contact@nova2labs.com
# LEAD_TO=contact@nova2labs.com

# ── Fallback relay (used only if SMTP above is unset or failing) ────────────
# Free key from https://web3forms.com — register it with contact@nova2labs.com.
# VITE_WEB3FORMS_KEY=
